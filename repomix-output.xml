#!/usr/bin/env python3
"""
Iterative Revision Loop: Generate -> Evaluate -> Revise
Uses anti-slop analysis and LLM judge to iteratively improve a layer or chapter.
"""

import time
from pathlib import Path
from scripts.config import LAYERS_DIR, CHAPTERS_DIR, WRITER_MODEL
from scripts.utils.ollama_client import call_model
from scripts.anti_slop import full_slop_analysis


def evaluate_content(content: str, layer: str) -> tuple:
    """Evaluate content quality. Returns (score, feedback)."""
    try:
        chapter_num = int(layer.split('_')[-1])
    except ValueError:
        chapter_num = 0

    print("   Running local mechanical + LLM anti-slop analysis...")
    analysis = full_slop_analysis(content, chapter_num)

    score = analysis["total_score"]
    feedback = (
        f"LLM Score: {analysis['llm_score']}/10\n"
        f"Mechanical Issues Spotted: {analysis['mechanical_issues']}\n"
        f"\nEditor Feedback:\n{analysis['llm_feedback']}"
    )
    print(f"   Overall Evaluation Score: {score}/10 | Target Met: {analysis['passed']}")
    return score, feedback


def revise_content(original: str, feedback: str, layer: str) -> str:
    """Revise content based on editor feedback."""
    prompt = (
        f"You are a master novelist. Revise the following {layer} using the provided editor feedback.\n"
        f"Keep the core strengths, fix the weaknesses, and filter out the monotonous phrasing.\n\n"
        f"Original Text:\n{original}\n\n"
        f"Editor Feedback:\n{feedback}\n\n"
        f"Output ONLY the revised text. Do not write conversational prefaces or postfaces."
    )
    return call_model(WRITER_MODEL, prompt, max_tokens=8500, temperature=0.72)


def iterative_improve(layer_name: str, content: str = None, max_iterations: int = 5, target_score: float = 7.2) -> str:
    """
    Run the full iterative improve loop for a chapter or layer.
    - layer_name: e.g. 'chapter_3', 'voice', 'world'
    - content: optional pre-loaded text (if None, loads from disk)
    - Returns the best version of the content.
    """
    # Determine path
    try:
        if "chapter" in layer_name:
            ch_num = int(layer_name.split('_')[-1])
            path = CHAPTERS_DIR / f"ch_{ch_num:02d}.md"
        else:
            path = LAYERS_DIR / f"{layer_name}.md"
    except ValueError:
        path = LAYERS_DIR / f"{layer_name}.md"

    # Load content if not provided
    if content is None:
        if path and path.exists():
            content = path.read_text(encoding='utf-8')
        else:
            content = "Draft content placeholder."

    print(f"\n=== Starting Iterative Revision Loop for: {layer_name} ===")

    for i in range(max_iterations):
        print(f"Iteration {i + 1}/{max_iterations}")

        score, feedback = evaluate_content(content, layer_name)

        if score >= target_score:
            print(f"[PASS] '{layer_name}' has passed the standard with score {score:.1f}!")
            if path:
                path.write_text(content, encoding='utf-8')
            return content

        print("Revising based on criticism...")
        new_content = revise_content(content, feedback, layer_name)

        if new_content:
            content = new_content
        else:
            print("Revision call failed. Falling back to prior iteration data.")

        time.sleep(1.5)

    print(f"[WARN] Iterative limit reached for {layer_name}. Committing best version.")
    if path:
        path.write_text(content, encoding='utf-8')
    return content
