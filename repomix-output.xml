#!/usr/bin/env python3
"""
Anti-Slop Analysis: Mechanical + LLM-based detection of AI writing tells.
"""

import re
from scripts.config import JUDGE_MODEL
from scripts.utils.ollama_client import call_model

SLOP_PATTERNS = [
    ("suddenly", "Overuse of 'suddenly'"),
    ("nodded slowly", "Cliché body language 'nodded slowly'"),
    ("a mix of", "Vague emotional descriptor 'a mix of'"),
    ("couldn't help but", "Weak construction 'couldn't help but'"),
    ("let out a breath", "Cliché 'let out a breath'"),
    ("in that moment", "Filler phrase 'in that moment'"),
    ("a shiver ran", "Cliché 'a shiver ran'"),
    ("heart raced", "Cliché 'heart raced'"),
    ("swallowed hard", "Cliché 'swallowed hard'"),
    ("took a deep breath", "Cliché 'took a deep breath'"),
    ("eyes widened", "Overused 'eyes widened'"),
    ("jaw dropped", "Overused 'jaw dropped'"),
    ("stomach dropped", "Overused 'stomach dropped'"),
]


def mechanical_slop_check(text: str) -> list:
    """Detect common AI slop patterns mechanically."""
    issues = []
    text_lower = text.lower()
    for pattern, name in SLOP_PATTERNS:
        matches = re.findall(pattern, text_lower)
        if len(matches) > 1:
            issues.append(f"{name} ({len(matches)} occurrences)")

    # Sentence length uniformity check
    sentences = [s.strip() for s in re.split(r'[.!?]+', text) if s.strip()]
    if sentences:
        lengths = [len(s.split()) for s in sentences]
        avg = sum(lengths) / max(len(lengths), 1)
        if avg > 0 and (max(lengths) - min(lengths)) < avg * 0.5:
            issues.append("Highly uniform sentence lengths (AI monotonous flow tell)")

    return issues


def llm_slop_judge(text: str, chapter_num: int = 0) -> tuple:
    """Use the judge model to score and give feedback on a chapter."""
    prompt = (
        f"You are an expert literary editor specializing in detecting AI-generated prose tells.\n"
        f"Analyze the following chapter for common AI writing flaws (monotonous sentence structures, "
        f"repetitive vocabulary, superficial melodrama, \"showing instead of telling\" issues).\n\n"
        f"Chapter {chapter_num}\n\n{text[:6000]}\n\n"
        f"Return exactly in this format:\n"
        f"SCORE: X/10 (where X is a number)\n"
        f"ISSUES: [Bullet points of specific problems with quotes from text]\n"
        f"SUGGESTIONS: [Actionable rewrite fixes]"
    )
    result = call_model(JUDGE_MODEL, prompt, temperature=0.4, max_tokens=1200)
    if not result:
        return 5.0, "No detailed feedback generated."

    score = 5.0
    match = re.search(r'SCORE:\s*(\d+\.?\d*)', result, re.IGNORECASE)
    if match:
        score = float(match.group(1))

    return score, result


def full_slop_analysis(text: str, chapter_num: int = 0) -> dict:
    """Combined mechanical + LLM anti-slop analysis."""
    mechanical_issues = mechanical_slop_check(text)
    llm_score, llm_feedback = llm_slop_judge(text, chapter_num)

    # Blend: LLM score with a small mechanical penalty
    penalty = len(mechanical_issues) * 0.15
    blended_score = round(max(0.0, llm_score - penalty), 2)

    return {
        "total_score": blended_score,
        "llm_score": llm_score,
        "mechanical_issues": mechanical_issues,
        "llm_feedback": llm_feedback,
        "passed": blended_score >= 7.0,
    }


def main():
    from scripts.config import CHAPTERS_DIR
    print("=== Anti-Slop Project Audit ===")
    chapters = sorted(CHAPTERS_DIR.glob("ch_*.md"))
    if not chapters:
        print("No chapters found in layers/chapters/.")
        return

    for ch in chapters:
        num = int(ch.stem.split("_")[1])
        text = ch.read_text(encoding="utf-8")
        print(f"\n--- Analyzing Chapter {num} ---")
        res = full_slop_analysis(text, num)
        print(f"Overall Score: {res['total_score']}/10 (Passed: {res['passed']})")
        if res['mechanical_issues']:
            print("Mechanical Tells Found:")
            for issue in res['mechanical_issues']:
                print(f"  - {issue}")
        else:
            print("Mechanical Tells Found: None")
        print("\nEditor Feedback:")
        print(res['llm_feedback'])


if __name__ == "__main__":
    main()
