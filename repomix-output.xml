import sys
from pathlib import Path
from scripts.config import LAYERS_DIR, REASONING_MODEL
from scripts.utils.ollama_client import call_model

def generate_layer(filename, prompt, context="", force=False):
    path = LAYERS_DIR / filename
    if path.exists() and path.stat().st_size > 0 and not force:
        print(f"[SKIP] {filename} already exists. (Delete '{path}' to regenerate)")
        return path.read_text(encoding="utf-8")

    print(f"Generating {filename}...")
    full_prompt = f"{context}\n\n{prompt}" if context else prompt
    content = call_model(
        model=REASONING_MODEL,
        prompt=full_prompt,
        system="You are an acclaimed novelist and worldbuilder laying the foundation for a new book.",
        max_tokens=4000,
        temperature=0.7
    )
    if content:
        path.write_text(content, encoding="utf-8")
        print(f"[OK] Saved {filename}")
        return content
    else:
        print(f"[FAIL] Failed to generate {filename}")
        return ""

def main():
    seed_file = Path("seed.txt")
    if not seed_file.exists():
        print("ERROR: seed.txt not found. Run with --phase seed first.")
        sys.exit(1)
        
    seed = seed_file.read_text(encoding="utf-8")
    
    print("\n--- Generating World ---")
    world = generate_layer("world.md", f"Create a detailed worldbuilding document based on this novel concept:\n\n{seed}")
    
    print("\n--- Generating Characters ---")
    characters = generate_layer("characters.md", f"Create detailed character profiles for the main cast based on this concept and world.\n\nConcept:\n{seed}\n\nWorld:\n{world}")
    
    print("\n--- Generating Outline ---")
    outline = generate_layer("outline.md", f"Create a detailed chapter-by-chapter outline (approx 12-20 chapters) based on the concept, world, and characters.\n\nConcept:\n{seed}\n\nWorld:\n{world}\n\nCharacters:\n{characters}")
    
    print("\n--- Generating Voice ---")
    voice = generate_layer("voice.md", f"Define the narrative voice, tone, themes, and stylistic guidelines for the prose based on this concept:\n\n{seed}")
    
    print("\nFoundation built successfully! You can now review the files in the 'layers' directory.")

if __name__ == "__main__":
    main()
