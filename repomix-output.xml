#!/usr/bin/env python3
"""
Audiobook Generation via Piper TTS
==================================
Uses Piper, a fast, local, and CPU-friendly Text-to-Speech engine.
This script avoids the need for a separate TTS server, making it more
resource-friendly for limited hardware.

Usage:
    python gen_audiobook.py                   # all chapters
    python gen_audiobook.py --chapter 3       # single chapter
    python gen_audiobook.py --force           # overwrite existing audio
"""
import argparse
import re
import sys
import time
import wave
from pathlib import Path

# Piper TTS is a lightweight, local TTS engine perfect for CPU.
try:
    from piper.voice import PiperVoice
    from piper.download import find_voice, download_voice
except ImportError:
    print("[ERROR] piper-tts is not installed. Run 'First-Time Setup' from the launcher.")
    sys.exit(1)

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
PROJECT_ROOT = Path(__file__).resolve().parent.parent

# Pull paths from scripts/config.py
sys.path.insert(0, str(Path(__file__).parent))
from config import CHAPTERS_DIR, AUDIO_OUTPUT_DIR, REFERENCE_VOICE_PATH

# Piper TTS configuration
PIPER_VOICE = "en_US-lessac-medium" # A high-quality, standard American English voice.
PIPER_MODEL_PATH = PROJECT_ROOT / "models" / "tts"


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def get_voice() -> PiperVoice | None:
    """Downloads and loads the Piper TTS voice model."""
    model_name = f"{PIPER_VOICE}.onnx"
    model_path = PIPER_MODEL_PATH / model_name
    PIPER_MODEL_PATH.mkdir(parents=True, exist_ok=True)

    # Download the voice model if it doesn't exist
    if not model_path.exists():
        try:
            print(f"    > Downloading voice model: {PIPER_VOICE}")
            download_voice(PIPER_VOICE, PIPER_MODEL_PATH)
        except Exception as e:
            print(f"[ERROR] Failed to download Piper voice model: {e}")
            return None
    try:
        return PiperVoice.load(str(model_path))
    except Exception as e:
        print(f"[ERROR] Could not load Piper voice model: {e}")
        return None


def clean_text(text: str) -> list[str]:
    """Strip markdown and split into speakable sentences."""
    # Remove chapter headings
    text = re.sub(r"#+ .*\n", "", text)
    # Remove markdown bold/italic
    text = re.sub(r"\*+([^*]+)\*+", r"\1", text)
    # Normalise quotes
    text = text.replace("\u201c", "").replace("\u201d", "").replace('"', "")
    # Flatten newlines
    text = text.replace("\n", " ")
    # Split on sentence boundaries
    sentences = re.split(r"(?<=[.!?])\s+", text)
    return [s.strip() for s in sentences if len(s.strip()) > 2]

def synthesize_sentence(voice: PiperVoice, sentence: str, output_path: Path):
    """Synthesize a sentence and save it as a temporary WAV file."""
    try:
        with wave.open(str(output_path), "wb") as wav_file:
            voice.synthesize(sentence, wav_file)
        return True
    except Exception as e:
        print(f"  [ERROR] Piper synthesis failed: {e}")
        return False


def wav_bytes_to_pcm(wav_bytes: bytes) -> tuple[bytes, int, int, int]:
    """
    Parse WAV bytes and return (pcm_data, sample_rate, channels, sampwidth).
    Raises ValueError if the format cannot be read.
    """
    import io
    with wave.open(io.BytesIO(wav_bytes)) as wf:
        sr      = wf.getframerate()
        ch      = wf.getnchannels()
        sw      = wf.getsampwidth()
        pcm     = wf.readframes(wf.getnframes())
    return pcm, sr, ch, sw


def combine_and_save(pcm_chunks: list[bytes], output_path: Path,
                     sample_rate: int, channels: int, sampwidth: int):
    """Write concatenated PCM chunks as a single WAV file."""
    output_path.parent.mkdir(parents=True, exist_ok=True)
    with wave.open(str(output_path), "wb") as wf:
        wf.setnchannels(channels)
        wf.setsampwidth(sampwidth)
        wf.setframerate(sample_rate)
        for chunk in pcm_chunks:
            wf.writeframes(chunk)


# ---------------------------------------------------------------------------
# Core generation
# ---------------------------------------------------------------------------

def generate_chapter_audio(voice: PiperVoice, ch_num: int, force: bool = False):
    """Generate audio for a single chapter via the Chatterbox server."""
    chapter_file = CHAPTERS_DIR / f"ch_{ch_num:02d}.md"
    output_file = AUDIO_OUTPUT_DIR / f"ch_{ch_num:02d}.wav"

    if not chapter_file.exists():
        print(f"[SKIP] Chapter {ch_num:02d} not found at {chapter_file}")
        return

    if output_file.exists() and not force:
        print(f"[SKIP] Chapter {ch_num:02d} audio already exists ({output_file.name}). Use --force to redo.")
        return

    print(f"\n{'='*60}")
    print(f"  Generating audio — Chapter {ch_num:02d}")
    print(f"{'='*60}")

    text = chapter_file.read_text(encoding="utf-8")
    sentences = clean_text(text)

    if not sentences:
        print(f"[WARN] Chapter {ch_num:02d} produced no speakable text.")
        return

    start = time.time()
    pcm_chunks = []
    sr = ch = sw = None
    temp_wav_path = AUDIO_OUTPUT_DIR / "_temp_sentence.wav"

    for i, sentence in enumerate(sentences, 1):
        preview = sentence[:70] + ("..." if len(sentence) > 70 else "")
        print(f"  [{i:03d}/{len(sentences):03d}] \"{preview}\"")

        if not synthesize_sentence(voice, sentence, temp_wav_path):
            print(f"           ^^^ skipped due to error")
            continue

        try:
            with temp_wav_path.open("rb") as f:
                wav_bytes = f.read()
                pcm, current_sr, current_ch, current_sw = wav_bytes_to_pcm(wav_bytes)
                pcm_chunks.append(pcm)
                if sr is None:
                    sr, ch, sw = current_sr, current_ch, current_sw
        except Exception as e:
            print(f"  [ERROR] Could not parse WAV response: {e}")

    if not pcm_chunks:
        print(f"[FAIL] No audio generated for Chapter {ch_num:02d}.")
        return

    combine_and_save(pcm_chunks, output_file, sr, ch, sw)
    elapsed = time.time() - start
    print(f"\n[OK] Chapter {ch_num:02d} saved → {output_file}  ({elapsed:.1f}s)")
    if temp_wav_path.exists():
        temp_wav_path.unlink()


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        description="Generate audiobook chapters via Piper TTS."
    )
    parser.add_argument("--chapter", type=int, help="Generate a specific chapter number only.")
    parser.add_argument("--force", action="store_true", help="Overwrite existing audio files.")
    args = parser.parse_args()

    # 1. Load Piper TTS Voice
    print(f"[INFO] Loading Piper TTS voice: {PIPER_VOICE}")
    print(f"       (Model will be downloaded to {PIPER_MODEL_PATH} if not found)")
    voice = get_voice()
    if not voice:
        print("[FAIL] Could not initialize Piper TTS. Cannot generate audiobook.")
        sys.exit(1)
    print("[OK] Piper TTS voice loaded successfully.")

    # 2. Build chapter list
    if args.chapter:
        chapters_to_run = [args.chapter]
    else:
        found = sorted(CHAPTERS_DIR.glob("ch_*.md"))
        if not found:
            print(f"\n[ERROR] No chapters found in {CHAPTERS_DIR}")
            print("        Draft some chapters first using 'Draft Chapter'.")
            sys.exit(1)
        chapters_to_run = [int(p.stem.split("_")[1]) for p in found]
        print(f"[INFO] Found {len(chapters_to_run)} chapter(s): {chapters_to_run}")

    # 3. Generate audio for each chapter
    for ch_num in chapters_to_run:
        generate_chapter_audio(voice, ch_num, args.force)

    print(f"\n[DONE] Audiobook audio saved to: {AUDIO_OUTPUT_DIR}")

if __name__ == "__main__":
    main()
