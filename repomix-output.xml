#!/usr/bin/env python3
"""
Revise all chapters that fall below a minimum quality score.
"""

import argparse
from scripts.config import CHAPTERS_DIR
from scripts.anti_slop import full_slop_analysis
from scripts.iterative_revision import iterative_improve


def get_chapter_score(ch_num: int) -> dict | None:
    """Evaluate a single chapter and return its analysis dict."""
    path = CHAPTERS_DIR / f"ch_{ch_num:02d}.md"
    if not path.exists():
        return None
    text = path.read_text(encoding="utf-8")
    if not text.strip():
        return None
    return full_slop_analysis(text, ch_num)


def revise_weak_chapters(min_score: float = 7.0, max_iterations: int = 4):
    """Find all chapters below min_score and revise them."""
    chapters = sorted(CHAPTERS_DIR.glob("ch_*.md"))
    if not chapters:
        print("No chapters found.")
        return

    print(f"\nScanning {len(chapters)} chapters for quality below {min_score}/10...\n")

    weak = []
    for ch_path in chapters:
        ch_num = int(ch_path.stem.split("_")[1])
        analysis = get_chapter_score(ch_num)
        if analysis is None:
            continue
        score = analysis["total_score"]
        print(f"  Chapter {ch_num}: {score:.1f}/10", end="")
        if score < min_score:
            print(" <- WEAK")
            weak.append(ch_num)
        else:
            print(" [OK]")

    if not weak:
        print(f"\nAll chapters meet the {min_score}/10 threshold. No revision needed.")
        return

    print(f"\nRevising {len(weak)} weak chapter(s): {weak}\n")

    for ch_num in weak:
        print(f"\n--- Revising Chapter {ch_num} ---")
        content = (CHAPTERS_DIR / f"ch_{ch_num:02d}.md").read_text(encoding="utf-8")

        final = iterative_improve(
            f"chapter_{ch_num}",
            content=content,
            max_iterations=max_iterations,
            target_score=min_score
        )

        # Save
        path = CHAPTERS_DIR / f"ch_{ch_num:02d}.md"
        path.write_text(final, encoding="utf-8")

        # Re-evaluate
        new_score = get_chapter_score(ch_num)
        if new_score:
            print(f"-> Chapter {ch_num} improved to {new_score['total_score']:.1f}/10")

    print("\nWeak chapter revision pass completed.")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Revise only weak chapters")
    parser.add_argument("--min-score", type=float, default=7.0,
                        help="Minimum acceptable score (default: 7.0)")
    parser.add_argument("--iterations", type=int, default=4,
                        help="Max revision iterations per weak chapter")
    args = parser.parse_args()

    revise_weak_chapters(min_score=args.min_score, max_iterations=args.iterations)
