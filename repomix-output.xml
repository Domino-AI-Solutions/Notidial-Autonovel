#!/usr/bin/env python3
"""
Audiobook Generation with local Better-Chatterbox TTS
Clones a voice from a reference file and generates audio for chapters.
"""

import argparse
import re
import time
from pathlib import Path

try:
    from chatterbox import Chatterbox
    import soundfile as sf
    import torch
except ImportError:
    print("ERROR: chatterbox-tts or soundfile is not installed.")
    print('Please install it: pip install "chatterbox-tts @ git+https://github.com/fakerybakery/better-chatterbox@fix-cuda-issue" soundfile')
    exit(1)

from config import CHAPTERS_DIR, AUDIO_OUTPUT_DIR, REFERENCE_VOICE_PATH

def clean_text(text: str) -> list[str]:
    """Splits text into sentences for TTS processing."""
    text = re.sub(r'# Chapter \d+\n\n', '', text) # Remove chapter headings
    text = text.replace('\n', ' ').replace('"', '').replace('“', '').replace('”', '')
    # Split by sentences, keeping the delimiter
    sentences = re.split(r'(?<=[.!?])\s+', text)
    return [s.strip() for s in sentences if s.strip()]

def generate_chapter_audio(model: Chatterbox, ch_num: int, force: bool = False):
    """Generates audiobook for a single chapter."""
    chapter_file = CHAPTERS_DIR / f"ch_{ch_num:02d}.md"
    output_file = AUDIO_OUTPUT_DIR / f"ch_{ch_num:02d}.wav"

    if not chapter_file.exists():
        print(f"[SKIP] Chapter {ch_num} file not found.")
        return

    if output_file.exists() and not force:
        print(f"[SKIP] Chapter {ch_num} audio already exists. Use --force to regenerate.")
        return

    print(f"\n--- Generating audio for Chapter {ch_num} ---")
    text = chapter_file.read_text(encoding="utf-8")
    sentences = clean_text(text)
    if not sentences:
        print(f"[WARN] Chapter {ch_num} contains no text to speak.")
        return

    start_time = time.time()
    full_audio = []

    for i, sentence in enumerate(sentences):
        print(f"  -> ({i+1}/{len(sentences)}) Synthesizing: \"{sentence[:60]}...\"")
        wav = None
        try:
            if REFERENCE_VOICE_PATH.exists():
                # Use voice cloning if the reference file is present
                wav = model.generate(sentence, audio_prompt_path=str(REFERENCE_VOICE_PATH))
            else:
                # Use the default built-in voice if no reference is found
                wav = model.generate(sentence)
            
            if wav is not None:
                full_audio.append(wav.cpu().numpy().squeeze())
        except Exception as e:
            print(f"  [ERROR] Failed to generate audio for a sentence: {e}")

    if not full_audio:
        print(f"[FAIL] No audio was generated for Chapter {ch_num}.")
        return

    combined_wav = torch.cat([torch.tensor(a) for a in full_audio])
    sf.write(output_file, combined_wav, model.sr)
    end_time = time.time()
    print(f"[OK] Chapter {ch_num} audio saved to {output_file} (took {end_time - start_time:.2f}s)")

def main():
    parser = argparse.ArgumentParser(description="Generate audiobook from chapters using Better-Chatterbox.")
    parser.add_argument("--chapter", type=int, help="Specific chapter number to generate.")
    parser.add_argument("--force", action="store_true", help="Force regeneration even if audio file exists.")
    args = parser.parse_args()


    print("🚀 Initializing Better-Chatterbox TTS Model...")
    try:
        model = Chatterbox()
        print("✅ Model loaded successfully.")
    except Exception as e:
        print(f"❌ Failed to load Chatterbox model: {e}")
        return

    if REFERENCE_VOICE_PATH.exists():
        print(f"🎤 Found reference voice at '{REFERENCE_VOICE_PATH}'. Using it for voice cloning.")
    else:
        print("🎤 No reference voice found. Using the default built-in narrator voice.")
        print(f"   (To use a custom voice, place a WAV file at '{REFERENCE_VOICE_PATH}')")

    if args.chapter:
        generate_chapter_audio(model, args.chapter, args.force)
    else:
        chapters = sorted(CHAPTERS_DIR.glob("ch_*.md"))
        if not chapters:
            print("No chapter files found in 'layers/chapters/'.")
            return
        for chapter_path in chapters:
            ch_num = int(chapter_path.stem.split("_")[1])
            generate_chapter_audio(model, ch_num, args.force)

if __name__ == "__main__":
    main()
