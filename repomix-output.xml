"""
Revise a single chapter by number.
"""

import argparse
import sys
from pathlib import Path

# Ensure repo root is in sys.path when script is executed directly
repo_root = Path(__file__).resolve().parent.parent
if str(repo_root) not in sys.path:
    sys.path.insert(0, str(repo_root))

from scripts.config import CHAPTERS_DIR
from scripts.iterative_revision import iterative_improve


def revise_chapter(ch_num: int, max_iterations: int = 5, target_score: float = 7.2):
    """Load and iteratively revise a specific chapter."""
    path = CHAPTERS_DIR / f"ch_{ch_num:02d}.md"
    if not path.exists():
        print(f"Chapter {ch_num} not found at {path}")
        return None

    content = path.read_text(encoding="utf-8")
    if not content.strip():
        print(f"Chapter {ch_num} is empty.")
        return None

    print(f"\nRevising Chapter {ch_num}...")
    final = iterative_improve(
        f"chapter_{ch_num}",
        content=content,
        max_iterations=max_iterations,
        target_score=target_score
    )

    path.write_text(final, encoding="utf-8")
    print(f"[DONE] Chapter {ch_num} revision complete.")
    return final


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Revise a specific chapter")
    parser.add_argument("--chapter", type=int, required=True, help="Chapter number to revise")
    parser.add_argument("--iterations", type=int, default=5, help="Max revision iterations")
    parser.add_argument("--target", type=float, default=7.2, help="Target quality score")
    args = parser.parse_args()

    revise_chapter(args.chapter, max_iterations=args.iterations, target_score=args.target)
