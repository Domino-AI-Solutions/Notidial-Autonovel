#!/usr/bin/env python3
"""
Full Manuscript Evaluation + Reader Panel Simulation
- Mechanical + LLM evaluation
- 4-Persona Reader Panel (literary critic, genre reader, casual reader, editor)
- Overall score and detailed feedback
"""

import re
import json
import argparse
from pathlib import Path
from scripts.config import CHAPTERS_DIR, JUDGE_MODEL
from scripts.utils.ollama_client import call_model


def load_manuscript() -> str:
    """Combine all chapters into one manuscript text."""
    chapters = sorted(CHAPTERS_DIR.glob("ch_*.md"))
    if not chapters:
        print("No chapters found.")
        return ""

    full_text = []
    for ch in chapters:
        num = int(ch.stem.split("_")[1])
        content = ch.read_text(encoding="utf-8").strip()
        full_text.append(f"\n\n=== CHAPTER {num:02d} ===\n{content}")

    return "\n".join(full_text)


def mechanical_evaluation(text: str) -> dict:
    """Basic mechanical metrics."""
    words = len(text.split())
    sentences = len(re.split(r'[.!?]+', text))
    avg_sentence = words / sentences if sentences else 0

    return {
        "word_count": words,
        "avg_sentence_length": round(avg_sentence, 1),
        "chapter_count": len(list(CHAPTERS_DIR.glob("ch_*.md")))
    }


def reader_panel_evaluation(manuscript: str, max_words: int = 12000) -> dict:
    """Simulate 4 different reader personas."""
    excerpt = manuscript[:max_words]

    personas = [
        {"name": "Literary Critic", "focus": "prose quality, themes, literary merit"},
        {"name": "Genre Reader", "focus": "plot pacing, worldbuilding, entertainment value"},
        {"name": "Casual Reader", "focus": "emotional engagement, readability, enjoyment"},
        {"name": "Professional Editor", "focus": "consistency, pacing issues, slop, marketability"},
    ]

    panel_feedback = {}
    for persona in personas:
        prompt = (
            f"You are a {persona['name']}.\n"
            f"Analyze this novel excerpt with focus on {persona['focus']}.\n\n"
            f"Manuscript excerpt:\n{excerpt}\n\n"
            f"Give a score 1-10 and detailed, honest feedback (strengths + weaknesses)."
        )
        feedback = call_model(JUDGE_MODEL, prompt, temperature=0.6, max_tokens=1200)
        panel_feedback[persona["name"]] = feedback

    return panel_feedback


def overall_evaluation(manuscript: str) -> str:
    """Comprehensive LLM evaluation."""
    prompt = (
        "You are a senior publishing editor. Give an overall assessment of this novel manuscript.\n\n"
        "Consider:\n"
        "- Overall quality and market potential\n"
        "- Strengths and major weaknesses\n"
        "- Recommended next steps (revision priorities)\n\n"
        f"Manuscript:\n{manuscript[:10000]}"
    )
    return call_model(JUDGE_MODEL, prompt, temperature=0.4, max_tokens=1500)


def evaluate_all_chapters():
    """Entry point for evaluating all chapters (used by run_pipeline.py)."""
    main()


def main():
    parser = argparse.ArgumentParser(description="Full manuscript evaluation + reader panel")
    parser.add_argument("--save", action="store_true", help="Save evaluation report")
    args = parser.parse_args()

    print("Loading full manuscript...")
    manuscript = load_manuscript()
    if not manuscript:
        return

    print(f"Manuscript loaded ({len(manuscript.split()):,} words)\n")

    # Mechanical stats
    stats = mechanical_evaluation(manuscript)
    print("Mechanical Stats:")
