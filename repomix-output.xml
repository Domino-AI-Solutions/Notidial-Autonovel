#!/usr/bin/env python3
"""
Cover Art Prompt Generator
===========================
Reads seed.txt, asks the local Ollama model to distill a Stable-Diffusion-ready
image prompt of 77 tokens or fewer, saves it to art/cover_prompt.txt, prints it
to the log, then launches FastSD CPU (start.bat) so the user can paste the prompt
in and generate the image.
"""

import os
import sys
import subprocess
from pathlib import Path

# --- Resolve project root (works whether run directly or from launcher) ---
PROJECT_ROOT = Path(__file__).resolve().parent.parent
SEED_FILE    = PROJECT_ROOT / "seed.txt"
ART_DIR      = PROJECT_ROOT / "art"
PROMPT_FILE  = ART_DIR / "cover_prompt.txt"

# FastSD CPU location read from configuration.yaml if present, else default
FASTSD_DEFAULT = Path(r"C:\Users\opera\OneDrive\Desktop\Github-Repository\fastsdcpu")

def get_fastsd_dir() -> Path:
    """Read fastsd_dir from configuration.yaml, fall back to default."""
    config_file = PROJECT_ROOT / "configuration.yaml"
    if config_file.exists():
        for line in config_file.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line.startswith("fastsd_dir:"):
                raw = line.split(":", 1)[1].strip().strip('"').strip("'")
                return Path(raw)
    return FASTSD_DEFAULT


def build_prompt(seed_text: str) -> str:
    """
    Use the Ollama writer model to distill a <=77-token Stable Diffusion prompt
    from the novel's seed description.
    """
    # Import ollama_client from the project root
    sys.path.insert(0, str(PROJECT_ROOT))
    from ollama_client import call_model

    # Also pull the writer model name from scripts/config
    sys.path.insert(0, str(PROJECT_ROOT / "scripts"))
    from config import WRITER_MODEL

    instruction = (
        "You are a Stable Diffusion prompt engineer.\n"
        "Based on the following novel concept, write ONE image generation prompt "
        "suitable for a book cover.\n\n"
        "RULES:\n"
        "- Maximum 77 tokens (roughly 60-70 words). COUNT CAREFULLY.\n"
        "- Use vivid, visual, comma-separated descriptor tags.\n"
        "- Include art style, lighting, mood, and key visual elements.\n"
        "- Do NOT include character dialogue, plot spoilers, or long sentences.\n"
        "- Output ONLY the prompt text -- no explanation, no preamble, no quotes.\n\n"
        f"NOVEL CONCEPT:\n{seed_text}\n\n"
        "COVER IMAGE PROMPT:"
    )

    print("[INFO] Calling Ollama to generate image prompt from seed.txt...")
    result = call_model(WRITER_MODEL, instruction, temperature=0.6, max_tokens=120)
    return result.strip()


def enforce_token_limit(prompt: str, limit: int = 77) -> str:
    """Hard-truncate at token limit (approximate: split on spaces/commas)."""
    tokens = prompt.replace(",", " ,").split()
    if len(tokens) <= limit:
        return prompt
    truncated = " ".join(tokens[:limit])
    # Clean up trailing comma
    truncated = truncated.rstrip(" ,")
    print(f"[WARN] Prompt was over {limit} tokens -- truncated to fit.")
    return truncated


def launch_fastsd(fastsd_dir: Path):
    """Launch FastSD CPU via start.bat in a new console window."""
    start_bat = fastsd_dir / "start.bat"
    if not start_bat.exists():
        print(f"[ERROR] FastSD start.bat not found at: {start_bat}")
        print("        Please verify your FastSD CPU installation path in configuration.yaml")
        sys.exit(1)

    print(f"[INFO] Launching FastSD CPU from: {fastsd_dir}")
    try:
        subprocess.Popen(
            ["cmd", "/c", "start.bat"],
            cwd=str(fastsd_dir),
            creationflags=subprocess.CREATE_NEW_CONSOLE,
        )
        print("[OK] FastSD CPU launched in a new window.")
    except Exception as e:
        print(f"[ERROR] Failed to launch FastSD CPU: {e}")
        sys.exit(1)


def main():
    ART_DIR.mkdir(parents=True, exist_ok=True)

    # 1. Read seed.txt
    if not SEED_FILE.exists():
        print(f"[ERROR] seed.txt not found at: {SEED_FILE}")
        print("        Run 'Generate Seed' first to create it.")
        sys.exit(1)

    seed_text = SEED_FILE.read_text(encoding="utf-8").strip()
    if not seed_text:
        print("[ERROR] seed.txt is empty. Please generate or write your seed first.")
        sys.exit(1)

    print(f"[INFO] Read {len(seed_text)} characters from seed.txt")

    # 2. Generate image prompt via Ollama
    prompt = build_prompt(seed_text)
    if not prompt:
        print("[ERROR] Ollama returned an empty prompt. Is Ollama running?")
        sys.exit(1)

    # 3. Enforce 77-token limit
    prompt = enforce_token_limit(prompt, limit=77)

    # 4. Save and display
    PROMPT_FILE.write_text(prompt, encoding="utf-8")
    print("\n" + "="*60)
    print("COVER ART PROMPT (paste this into FastSD CPU):")
    print("="*60)
    print(prompt)
    print("="*60)
    print(f"\n[OK] Prompt saved to: {PROMPT_FILE}")

    # 5. Launch FastSD CPU
    fastsd_dir = get_fastsd_dir()
    launch_fastsd(fastsd_dir)

    print("\n[DONE] Paste the prompt above into FastSD CPU's prompt box and generate your cover art.")


if __name__ == "__main__":
    main()
