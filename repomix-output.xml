"""
Generate novel seed concepts using the reasoning model.
"""

import argparse
from scripts.config import REASONING_MODEL
from scripts.utils.ollama_client import call_model


def generate_seeds(num_seeds: int = 5) -> list:
    """Generate multiple novel seed concepts."""
    prompt = (
        f"Generate {num_seeds} compelling and unique novel concept seeds. "
        f"Each seed should be a paragraph describing: the core premise, the protagonist, "
        f"the central conflict, and the thematic heart of the story.\n\n"
        f"Number each one clearly. Make them varied across genre, tone, and setting. "
        f"Prioritize originality and emotional depth."
    )

    print("Generating novel seed concepts...")
    result = call_model(
        model=REASONING_MODEL,
        prompt=prompt,
        system="You are a creative writing consultant generating original novel concepts.",
        max_tokens=3000,
        temperature=0.9
    )

    if not result:
        print("Failed to generate seeds.")
        return []

    # Save candidates
    from pathlib import Path
    candidates_path = Path("seed_candidates.txt")
    candidates_path.write_text(result, encoding="utf-8")
    print(f"[OK] {num_seeds} seeds saved to seed_candidates.txt")
    print("-> Review seed_candidates.txt and copy your favourite to seed.txt")

    return result.split("\n\n")


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--count", type=int, default=5, help="Number of seeds to generate")
    args = parser.parse_args()
    generate_seeds(args.count)
