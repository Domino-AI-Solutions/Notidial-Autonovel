import argparse
import sys
from pathlib import Path

# Ensure repo root is in sys.path when script is executed directly
repo_root = Path(__file__).resolve().parent.parent
if str(repo_root) not in sys.path:
    sys.path.insert(0, str(repo_root))

from scripts.config import LAYERS_DIR, CHAPTERS_DIR, WRITER_MODEL
from scripts.utils.ollama_client import call_model
from scripts.iterative_revision import iterative_improve

def load_relevant_context(ch_num: int, max_prev=1):
    context = []

    # Voice & Style Guide
    voice_path = LAYERS_DIR / "voice.md"
    if voice_path.exists():
        context.append(f"=== VOICE & STYLE ===\n{voice_path.read_text(encoding='utf-8')[:2000]}")

    # World & Characters
    for file_name in ["world", "characters"]:
        p = LAYERS_DIR / f"{file_name}.md"
        if p.exists():
            context.append(f"=== {file_name.upper()} ===\n{p.read_text(encoding='utf-8')[:1800]}")

    # Plot Outline
    outline_path = LAYERS_DIR / "outline.md"
    if outline_path.exists():
        context.append(f"=== OUTLINE ===\n{outline_path.read_text(encoding='utf-8')[:2500]}")

    # Continuity Context from Previous Chapters (Minimize context)
    for i in range(max(1, ch_num - max_prev), ch_num):
        prev_path = CHAPTERS_DIR / f"ch_{i:02d}.md"
        if prev_path.exists():
            text = prev_path.read_text(encoding="utf-8")
            lines = text.splitlines()
            # Feed only the last ~25 lines to minimize context but keep continuity
            excerpt = "\n".join(lines[-25:]) if len(lines) > 25 else text
            context.append(f"=== PREVIOUS CHAPTER {i} (Ending Context) ===\n{excerpt}")

    return "\n\n".join(context)

def draft_and_revise(ch_num: int, max_iterations=5, target_score=7.2, force=False):
    chapter_path = CHAPTERS_DIR / f"ch_{ch_num:02d}.md"
    if chapter_path.exists() and chapter_path.stat().st_size > 0 and not force:
        print(f"[SKIP] Chapter {ch_num} already exists ({chapter_path}). Delete file to re-draft.")
        return chapter_path.read_text(encoding="utf-8")

    print(f"\nDrafting Chapter {ch_num}...")
    context = load_relevant_context(ch_num)

    draft_prompt = f"""You are writing Chapter {ch_num} of this book.
Incorporate the voice guidelines, stay consistent with previous events, and follow the plot outline.

CRITICAL ANTI-SLOP STYLE RULES:
- Show, don't tell. Avoid melodramatic narrative summaries.
- NEVER use AI cliché tells or repetitive phrases (e.g., 'nodded slowly', 'heart raced', 'swallowed hard', 'took a deep breath', 'a shiver ran', 'couldn't help but', 'eyes widened', 'let out a breath', 'in that moment').
- Vary sentence length and structure to create dynamic, engaging prose rhythm.

CONTEXT:
{context}

Draft the entire chapter. Include a bold chapter title."""

    initial_draft = call_model(
        model=WRITER_MODEL,
        prompt=draft_prompt,
        system="You are an acclaimed novelist producing continuous narrative chapters.",
        max_tokens=8500,
        temperature=0.75
    )

    if not initial_draft:
        print("Failed to establish base draft.")
        return None

    chapter_path = CHAPTERS_DIR / f"ch_{ch_num:02d}.md"
    chapter_path.write_text(initial_draft, encoding="utf-8")
    
    # Skipping per-chapter slop testing/revision here.
    # It will be handled in batch by revise_all_weak_chapters.py later!
    print(f"[PASS] Chapter {ch_num} drafted & saved (Slop testing deferred to revision phase).")
    return initial_draft

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--chapter", type=int, required=True)
    parser.add_argument("--iterations", type=int, default=5)
    parser.add_argument("--target", type=float, default=7.2)
    args = parser.parse_args()

    draft_and_revise(args.chapter, max_iterations=args.iterations, target_score=args.target)
